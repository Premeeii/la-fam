# ==========================================
# Database Configuration
# ==========================================
DB_URL=jdbc:postgresql://localhost:5432/lafam_db
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password

# ==========================================
# Security & JWT Configuration
# ==========================================
JWT_SECRET=your_jwt_secret_key_here_at_least_32_chars
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Set COOKIE_SECURE=false for HTTP local dev, true for HTTPS production
COOKIE_SECURE=false

# ==========================================
# CORS & App Settings
# ==========================================
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ==========================================
# Cloudflare R2 Storage
# ==========================================
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key
R2_BUCKET_NAME=lafam-avatar
R2_PUBLIC_URL=https://your-public-r2-url.dev

# ==========================================
# Cloudflare Turnstile
# ==========================================
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# ==========================================
# Resend Email Service
# ==========================================
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev
